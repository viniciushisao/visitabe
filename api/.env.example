NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAPI_ENABLED=true
# Required when OPENAPI_ENABLED=true outside development.
# OPENAPI_BASIC_AUTH_USERNAME=docs
# OPENAPI_BASIC_AUTH_PASSWORD="replace-with-high-entropy-secret"

AUTH_ISSUER=https://api.visita.app
AUTH_AUDIENCE=visita-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_JWT_ALGORITHM=HS256
AUTH_REFRESH_TOKEN_PEPPER="replace-with-high-entropy-secret"
JWT_SECRET="replace-with-high-entropy-secret"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/visita?schema=public"
OPENAI_API_KEY="replace-me"
